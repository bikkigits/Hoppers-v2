rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCrowdData(data) {
      return data.low is number && data.low >= 0 &&
             data.moderate is number && data.moderate >= 0 &&
             data.heavy is number && data.heavy >= 0 &&
             data.extreme is number && data.extreme >= 0;
    }

    // Pandal Crowd Real-Time Voting Collection
    match /pandal_crowd/{pandalId} {
      // Allow public read for real-time map crowd status
      allow read: if isValidId(pandalId);

      // Allow public crowd voting increments
      allow create, update: if isValidId(pandalId) && isValidCrowdData(incoming());
      allow delete: if false;
    }
  }
}
